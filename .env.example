# ── Database ──────────────────────────────────────────────────────────────────
# The SAME MongoDB connection string the old backend used as MONGO_URI
# (include the database name, e.g. ...mongodb.net/levelup). MongoDB 8.0+.
DATABASE_URL="mongodb+srv://user:password@cluster.mongodb.net/your-db-name"

# ── Auth (Better Auth) ────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
# Public URL of the site (no trailing slash)
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Google sign-in (optional). The old site only needed the client ID; the new
# flow also needs the client secret, and this redirect URI added in Google Cloud:
#   <site url>/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── Email (Gmail SMTP — same as before) ───────────────────────────────────────
# Without these, emails are not sent; codes are printed in the server log instead.
GMAIL_USER=""
GMAIL_APP_PASSWORD=""

# ── Image uploads (Cloudinary — same as before) ───────────────────────────────
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ── Optional ──────────────────────────────────────────────────────────────────
GOOGLE_SITE_VERIFICATION=""
NEXT_PUBLIC_INSTAGRAM_URL=""
NEXT_PUBLIC_FACEBOOK_URL=""
NEXT_PUBLIC_TIKTOK_URL=""
